# Environment variables for Tradox accounts (Supabase).
#
# Copy this file to `.env.local` in the repo root and fill in the two values.
# `.env.local` is git-ignored and must never be committed.
#
# (This template is named `env.example` without a leading dot because the
# repo's .gitignore ignores every `.env*` file, which would hide a
# `.env.example` from git too.)
#
# Both values come from your Supabase project: Project Settings -> API Keys.
# They are PUBLIC keys: safe to ship to the browser, because every table is
# protected by row-level security (see supabase/schema.sql).
#
# Leave both empty (or delete .env.local) and the whole sign-in feature
# disappears: no Sign in button, no profile menu, no sync. The site works
# exactly as before.

NEXT_PUBLIC_SUPABASE_URL=
# The "publishable" key (starts with sb_publishable_). The older "anon"
# key works too - put it in the same variable.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
